# Local development only. Copy to .env and change the password for your machine.
POSTGRES_USER=hackalem
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=hackalem
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hackalem:change-me-local@localhost:5432/hackalem

# OpenAI is used only by the server. Never put real keys in this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
